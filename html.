                <button class="btn" style="background:#64748b;" onclick="restartGame()">🔄 Ulangi Latihan</button>
            </div>
        </div>

    </div>

    <!-- Footer -->
    <footer>
        Media Pembelajaran Edukatif PAI Kelas 7 Fase D &bull; Kurikulum Merdeka &bull; Siap Diunggah ke GitHub Pages
    </footer>
</div>

<script>
    /* ===================================================
       AUDIO SYNTHESIZER (Web Audio API - No External Files)
       =================================================== */
    let audioCtx = null;
    let audioEnabled = true;

    function initAudio() {
        if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
    }

    function toggleAudio() {
        audioEnabled = !audioEnabled;
        document.getElementById('mute-btn').innerText = audioEnabled ? '🔊' : '🔇';
    }

    function playSound(type) {
        if (!audioEnabled) return;
        initAudio();
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        const now = audioCtx.currentTime;

        if (type === 'correct') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(523.25, now); // C5
            osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.15); // E5
            gain.gain.setValueAtTime(0.3, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
            osc.start(now);
            osc.stop(now + 0.3);
        } else if (type === 'wrong') {
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(220, now); // A3
            osc.frequency.setValueAtTime(174.61, now + 0.1); // F3
            gain.gain.setValueAtTime(0.3, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
            osc.start(now);
            osc.stop(now + 0.3);
        } else if (type === 'complete') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(440, now);
            osc.frequency.setValueAtTime(554.37, now + 0.1);
            osc.frequency.setValueAtTime(659.25, now + 0.2);
            gain.gain.setValueAtTime(0.3, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
            osc.start(now);
            osc.stop(now + 0.5);
        }
    }

    /* ===================================================
       GAME STATE & DATA
       =================================================== */
    let userData = {
        name: '',
        class: '',
        score: 0,
        lives: 3,
        commit1: '',
        commit2: ''
    };

    let currentQuizIndex = 0;

    const quizQuestions = [
        {
            question: "Manakah di bawah ini yang merupakan definisi paling tepat dari konsep ikhlas dalam beribadah?",
            options: [
                "Mengerjakan ibadah agar disukai oleh guru dan dipuji orang tua.",
                "Memurnikan niat beribadah hanya semata-mata mengharapkan ridha Allah Swt.",
                "Melakukan ibadah shalat hanya ketika berada di lingkungan sekolah.",
                "Berdoa dengan suara lantang agar orang lain mengetahui ketakwaan kita."
            ],
            correct: 1,
            explanation: "Ikhlas secara bahasa berarti murni. Ikhlas dalam ibadah artinya membersihkan niat dari tujuan selain Allah Swt."
        },
        {
            question: "Surah Al-Bayyinah [98] ayat 5 menegaskan bahwa umat manusia diperintahkan untuk menyembah Allah Swt. dengan syarat...",
            options: [
                "Menghafal seluruh isi ayat Al-Qur'an dalam waktu singkat.",
                "Memurnikan ketaatan kepada-Nya dalam menjalankan agama.",
                "Mengeluarkan seluruh harta benda tanpa tersisa.",
                "Melakukan ibadah di tempat yang sangat terpencil saja."
            ],
            correct: 1,
            explanation: "Q.S. Al-Bayyinah ayat 5 menekankan 'mukhlisiina lahud-diin', yaitu memurnikan ketaatan/agama hanya untuk Allah."
        },
        {
            question: "Ahmad tetap menyapu dan merapikan ruang kelas saat tugas piket, meskipun teman-teman satu kelompoknya sudah pulang duluan. Sikap Ahmad mencerminkan...",
            options: [
                "Pamer keterampilan agar dijadikan ketua kelas.",
                "Kehati-hatian karena takut dimarahi guru piket.",
                "Bentuk ikhlas dalam menjalankan tanggung jawab dan amanah sekolah.",
                "Sikap terpaksa karena tidak punya pilihan lain."
            ],
            correct: 2,
            explanation: "Melaksanakan tanggung jawab dengan sungguh-sungguh tanpa tergantung kehadiran orang lain adalah ciri ikhlas dalam muamalah/sekolah."
        },
        {
            question: "Saat kerja kelompok PAI, Nisa mendapati bagian tugas temannya kurang rapi. Tindakan Nisa yang mencerminkan ikhlas dalam berinteraksi adalah...",
            options: [
                "Mengejeknya di depan kelas agar teman tersebut merasa malu.",
                "Membantunya merapikan tulisan dengan ramah tanpa menyombongkan diri.",
                "Melaporkan kesalahan teman tersebut ke media sosial.",
                "Menolak membantu jika tidak diberi imbalan uang saku."
            ],
            correct: 1,
            explanation: "Ikhlas dalam bermuamalah diwujudkan dengan membantu sesama secara santun tanpa niat merendahkan atau meminta imbalan."
        },
        {
            question: "Siti bersedekah memasukkan uang ke kotak amal masjid sekolah. Ia berusaha tidak menceritakan jumlah uangnya kepada teman-temannya. Perilaku Siti bertujuan untuk menghindari penyakit hati yaitu...",
            options: [
                "Pikir (Pelit)",
                "Riya' dan Sum'ah (Pamer dan ingin didengar)",
                "Tawakal",
                "Qana'ah"
            ],
            correct: 1,
            explanation: "Menyembunyikan amalan kebaikan adalah salah satu cara menjaga hati dari riya' (pamer) dan sum'ah (mencari popularitas)."
        }
    ];

    const simulasiItems = [
        { id: 1, text: "Tetap belajar dengan tekun saat ada maupun tidak ada ujian.", category: "ikhlas" },
        { id: 2, text: "Rajin shalat berjamaah di sekolah hanya saat diawasi guru PAI.", category: "riya" },
        { id: 3, text: "Membantu merapikan mukena di mushalla sekolah secara diam-diam.", category: "ikhlas" },
        { id: 4, text: "Mengunggah foto struk donasi di media sosial agar dipuji dermawan.", category: "riya" },
        { id: 5, text: "Menerima kritik dan saran teman kelompok demi kebaikan bersama.", category: "ikhlas" },
        { id: 6, text: "Mengungkit-ungkit kebaikan yang pernah diberikan kepada teman saat berselisih.", category: "riya" }
    ];

    let selectedSimItem = null;
    let simAssignments = { ikhlas: [], riya: [] };

    /* ===================================================
       FLOW NAVIGATION LOGIC
       =================================================== */
    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
        updateProgressBar();
    }

    function updateProgressBar() {
        const screens = ['screen-welcome', 'screen-materi', 'screen-quiz', 'screen-simulasi', 'screen-refleksi', 'screen-result'];
        const activeIndex = screens.findIndex(id => document.getElementById(id).classList.contains('active'));
        const percentage = (activeIndex / (screens.length - 1)) * 100;
        document.getElementById('progress-bar').style.width = percentage + '%';
    }

    function startLearning() {
        const name = document.getElementById('input-name').value.trim();
        const cls = document.getElementById('input-class').value.trim();

        if (!name) {
            alert('Mohon isi nama lengkapmu terlebih dahulu!');
            return;
        }

        userData.name = name;
        userData.class = cls || '7';
        userData.score = 0;
        userData.lives = 3;

        updateHeaderStats();
        showScreen('screen-materi');
    }

    function updateHeaderStats() {
        document.getElementById('score-display').innerText = userData.score;
        document.getElementById('lives-display').innerText = userData.lives;
    }

    function nextStep() {
        const activeScreen = document.querySelector('.screen.active').id;
        if (activeScreen === 'screen-materi') {
            initQuiz();
            showScreen('screen-quiz');
        } else if (activeScreen === 'screen-simulasi') {
            showScreen('screen-refleksi');
        }
    }

    /* ===================================================
       QUIZ LOGIC
       =================================================== */
    function initQuiz() {
        currentQuizIndex = 0;
        renderQuizQuestion();
    }

    function renderQuizQuestion() {
        const q = quizQuestions[currentQuizIndex];
        document.getElementById('quiz-step-text').innerText = `Soal ${currentQuizIndex + 1} dari ${quizQuestions.length}`;
        document.getElementById('quiz-question').innerText = q.question;

        const optionsContainer = document.getElementById('options-container');
        optionsContainer.innerHTML = '';

        const feedbackBox = document.getElementById('feedback-box');
        feedbackBox.className = 'feedback-box';
        feedbackBox.style.display = 'none';

        document.getElementById('next-quiz-btn').style.display = 'none';

        q.options.forEach((opt, idx) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerHTML = `<span>${String.fromCharCode(65 + idx)}. ${opt}</span>`;
            btn.onclick = () => checkAnswer(idx);
            optionsContainer.appendChild(btn);
        });
    }

    function checkAnswer(selectedIndex) {
        const q = quizQuestions[currentQuizIndex];
        const buttons = document.querySelectorAll('.option-btn');
        const feedbackBox = document.getElementById('feedback-box');

        // Disable all buttons after selection
        buttons.forEach(b => b.onclick = null);

        if (selectedIndex === q.correct) {
            playSound('correct');
            buttons[selectedIndex].classList.add('correct');
            userData.score += 20;
            feedbackBox.innerHTML = `<strong>Jawaban Benar! 🎉</strong><br>${q.explanation}`;
            feedbackBox.className = 'feedback-box show correct';
        } else {
            playSound('wrong');
            buttons[selectedIndex].classList.add('wrong');
            buttons[q.correct].classList.add('correct');
            userData.lives = Math.max(0, userData.lives - 1);
            feedbackBox.innerHTML = `<strong>Jawaban Kurang Tepat! ⚠️</strong><br>${q.explanation}`;
            feedbackBox.className = 'feedback-box show wrong';
        }

        updateHeaderStats();
        document.getElementById('next-quiz-btn').style.display = 'block';
    }

    function handleNextQuiz() {
        currentQuizIndex++;
        if (currentQuizIndex < quizQuestions.length && userData.lives > 0) {
            renderQuizQuestion();
        } else {
            initSimulasi();
            showScreen('screen-simulasi');
        }
    }

    /* ===================================================
       SIMULASI / MATCHING LOGIC
       =================================================== */
    function initSimulasi() {
        simAssignments = { ikhlas: [], riya: [] };
        selectedSimItem = null;

        const container = document.getElementById('classify-items');
        container.innerHTML = '';

        document.getElementById('list-ikhlas').innerHTML = '';
        document.getElementById('list-riya').innerHTML = '';
        document.getElementById('sim-feedback').style.display = 'none';
        document.getElementById('check-sim-btn').style.display = 'block';
        document.getElementById('next-sim-btn').style.display = 'none';

        simulasiItems.forEach(item => {
            const div = document.createElement('div');
            div.className = 'drag-item';
            div.id = `sim-item-${item.id}`;
            div.innerText = item.text;
            div.onclick = () => selectSimItem(item.id);
            container.appendChild(div);
        });
    }

    function selectSimItem(id) {
        selectedSimItem = id;
        document.querySelectorAll('.drag-item').forEach(el => {
            el.style.border = '1px solid #cbd5e1';
            el.style.background = 'white';
        });

        const activeEl = document.getElementById(`sim-item-${id}`);
        if (activeEl) {
            activeEl.style.border = '2px solid var(--primary)';
            activeEl.style.background = '#e6fffa';
        }
    }

    function assignSelected(targetCategory) {
        if (!selectedSimItem) {
            alert('Pilih/klik salah satu pernyataan di atas terlebih dahulu!');
            return;
        }

        const item = simulasiItems.find(i => i.id === selectedSimItem);
        
        // Remove from old categories
        simAssignments.ikhlas = simAssignments.ikhlas.filter(i => i.id !== item.id);
        simAssignments.riya = simAssignments.riya.filter(i => i.id !== item.id);

        // Add to new
        simAssignments[targetCategory].push(item);

        // Move DOM element
        const el = document.getElementById(`sim-item-${item.id}`);
        document.getElementById(`list-${targetCategory}`).appendChild(el);
        el.style.border = '1px solid #cbd5e1';
        el.style.background = 'white';

        selectedSimItem = null;
    }

    function checkSimulation() {
        let correctCount = 0;
        let total = simulasiItems.length;

        simAssignments.ikhlas.forEach(i => { if(i.category === 'ikhlas') correctCount++; });
        simAssignments.riya.forEach(i => { if(i.category === 'riya') correctCount++; });

        const feedbackBox = document.getElementById('sim-feedback');
        feedbackBox.style.display = 'block';

        if (correctCount === total) {
            playSound('correct');
            userData.score += 20;
            feedbackBox.className = 'feedback-box show correct';
            feedbackBox.innerHTML = `<strong>Luar Biasa! 👏</strong> Semua perilaku berhasil kamu klasifikasikan dengan tepat! (+20 Poin)`;
            document.getElementById('check-sim-btn').style.display = 'none';
            document.getElementById('next-sim-btn').style.display = 'block';
        } else {
            playSound('wrong');
            feedbackBox.className = 'feedback-box show wrong';
            feedbackBox.innerHTML = `Kamu berhasil mengelompokkan ${correctCount} dari ${total} pernyataan dengan benar. Periksa kembali pilihanmu lalu coba klik verifikasi lagi!`;
        }
        updateHeaderStats();
    }

    /* ===================================================
       FINAL SUMMARY & CERTIFICATE LOGIC
       =================================================== */
    function finishJourney() {
        const c1 = document.getElementById('commit-1').value.trim();
        const c2 = document.getElementById('commit-2').value.trim();

        if (!c1 || !c2) {
            alert('Mohon lengkapi kedua pertanyaan refleksi komitmenmu!');
            return;
        }

        userData.commit1 = c1;
        userData.commit2 = c2;

        playSound('complete');

        // Fill Certificate Data
        document.getElementById('cert-name').innerText = userData.name;
        document.getElementById('cert-class').innerText = 'Kelas: ' + userData.class;
        document.getElementById('final-score').innerText = userData.score + ' / 120';

        let predicate = 'Cukup';
        if (userData.score >= 100) predicate = 'Sangat Baik (Siddiq)';
        else if (userData.score >= 70) predicate = 'Baik (Ikhlas)';
        
        document.getElementById('final-predicate').innerText = predicate;
        document.getElementById('cert-commit').innerText = `"${c1} Serta menjaga hati dengan cara: ${c2}"`;

        showScreen('screen-result');
    }

    function restartGame() {
        userData.score = 0;
        userData.lives = 3;
        document.getElementById('input-name').value = '';
        document.getElementById('input-class').value = '';
        document.getElementById('commit-1').value = '';
        document.getElementById('commit-2').value = '';
        updateHeaderStats();
        showScreen('screen-welcome');
    }
</script>
</body>
</html>
