            </div>

            <div id="feedback-box" class="feedback-box"></div>

            <button class="btn btn-center" id="next-quiz-btn" style="display:none;" onclick="handleNextQuiz()">Pertanyaan Selanjutnya ➡️</button>
        </div>

        <!-- SCREEN 4: PRAKTIK & SIMULASI IKHLAS (MATCHING) -->
        <div id="screen-simulasi" class="screen">
            <h2>Modul 3: Membedakan Perilaku (Ikhlas vs Riya)</h2>
            <p class="desc">Klik pada item pernyataan di bawah ini untuk memasukkannya ke dalam kategori yang tepat!</p>

            <div id="classify-items" style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:15px; justify-content:center;">
