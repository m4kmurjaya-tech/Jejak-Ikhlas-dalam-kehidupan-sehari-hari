            <button class="btn btn-center" onclick="finishJourney()">Selesaikan & Lihat Hasil 🎓</button>
        </div>

        <!-- SCREEN 6: RESULT & CERTIFICATE -->
        <div id="screen-result" class="screen">
            <h2>Hasil Akhir Pembelajaran</h2>
            <p class="desc">Terima kasih telah menyelesaikan seluruh tahapan belajar!</p>

            <div class="certificate-card" id="certificate">
                <p style="text-transform:uppercase; letter-spacing:2px; font-size:0.8rem; color:var(--text-muted);">Sertifikat Komitmen Pembelajar</p>
                <h3>IKHLAS DALAM AMAL</h3>
                <p>Diberikan Kepada:</p>
                <div class="student-name" id="cert-name">Nama Siswa</div>
                <p style="font-size:0.9rem; color:var(--text-muted);" id="cert-class">Kelas: -</p>

                <div style="margin:20px 0; display:flex; justify-content:center; gap:20px;">
                    <div>
                        <div style="font-size:1.5rem; font-weight:bold; color:var(--primary);" id="final-score">0</div>
                        <div style="font-size:0.8rem; color:var(--text-muted);">Skor Pemahaman</div>
                    </div>
                    <div>
                        <div style="font-size:1.5rem; font-weight:bold; color:var(--secondary);" id="final-predicate">Sangat Baik</div>
                        <div style="font-size:0.8rem; color:var(--text-muted);">Predikat Sikap</div>
                    </div>
                </div>

                <div style="text-align:left; background:#f8fafc; padding:12px; border-radius:8px; font-size:0.85rem; color:var(--text-main); margin-top:10px;">
                    <strong>Komitmen Diri Saya:</strong>
                    <p id="cert-commit" style="font-style:italic; margin-top:4px; color:var(--text-muted);"></p>
